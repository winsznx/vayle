# Robinhood Chain mainnet RPC URL with archive access. Fork tests and the chain facts script read it.
ROBINHOOD_RPC_URL=
# Incoming webhook the watcher posts alerts to (Slack-compatible JSON). Set as a Worker secret.
WATCHER_WEBHOOK_URL=
# Supabase project URL for the watcher's state table. Set as a Worker secret.
SUPABASE_URL=
# Supabase service role key, used only by the watcher's Worker to read and write its state row.
SUPABASE_SERVICE_ROLE_KEY=
# Deploy only. Private key of a fresh deploy-only account funded with gas, discarded after the deploy.
DEPLOYER_KEY=
# Deploy only. The multisig that becomes the timelock's proposer, canceller and executor.
MULTISIG=
# Deploy only. The guardian key's address, which can pause new positions and halt.
GUARDIAN=
# Deploy only. Where protocol fees are credited.
FEE_RECIPIENT=
# Deploy only. The team's maker address, flagged as team-operated on every fill.
TEAM_MAKER=
# Deploy only. Timelock delay in seconds, at least 8 days 6 hours.
TIMELOCK_DELAY=
# Deploy only. Call caps in raw units: open size, wallet size, series open interest, fill size.
CALL_CAPS=
# Deploy only. Put caps in raw units, in the same order. Zero keeps buy orders closed.
PUT_CAPS=
