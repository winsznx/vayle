# Robinhood Chain mainnet RPC URL with archive access. Fork tests and the chain facts script read it.
ROBINHOOD_RPC_URL=
# Incoming webhook the watcher posts alerts to (Slack-compatible JSON). Set as a Worker secret.
WATCHER_WEBHOOK_URL=
# Supabase project URL for the watcher's state table. Set as a Worker secret.
SUPABASE_URL=
# Supabase service role key, used only by the watcher's Worker to read and write its state row.
SUPABASE_SERVICE_ROLE_KEY=
