# Robinhood Chain mainnet RPC URL with archive access. Fork tests and the chain facts script read it.
ROBINHOOD_RPC_URL=
# Incoming webhook the watcher posts alerts to: a Discord webhook gets Discord's content field, any other URL JSON with a text field. Set as a Worker secret.
WATCHER_WEBHOOK_URL=
# Indexer run as a Node process. The market's address, once deployed.
VAYLE_MARKET=
# Indexer run as a Node process. The block the market was deployed at.
VAYLE_START_BLOCK=
# Supabase project URL for the watcher's state table. Set as a Worker secret.
SUPABASE_URL=
# Supabase service role key, used only by the watcher's Worker to read and write its state row.
SUPABASE_SERVICE_ROLE_KEY=
# Deploy only. Private key of a fresh deploy-only account funded with gas, discarded after the deploy.
DEPLOYER_KEY=
# Deploy only. The multisig that becomes the timelock's proposer, canceller and executor, and receives protocol fees.
MULTISIG=
# Deploy only. The guardian key's address, which can pause new positions and halt.
GUARDIAN=
# Deploy only. The team's maker address, flagged as team-operated on every fill.
TEAM_MAKER=
# Private key of the keeper's account, which holds gas only and never user funds. Set as a Worker secret.
KEEPER_KEY=
# Private key of the team-operated maker's account, which holds its USDG and each market's token. Set as a Worker secret.
MAKER_KEY=
# Maker pricing, set by the owner. How far under fair value the maker bids, in basis points. Each market's volatility comes from deployments/markets.json.
MAKER_EDGE_BPS=
# Maker pricing. The gross annual dividend yield it assumes for every market, in basis points. The model keeps the withheld 30% of it.
MAKER_DIVIDEND_YIELD_BPS=
# Maker pricing. Annual USDG rate in basis points.
MAKER_RATE_BPS=
# Maker behavior. on to quote new orders mid-week, off to bid only into the weekly batch.
MAKER_RFQ=
