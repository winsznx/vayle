// The site on Cloudflare Workers: the Vite build as static assets, with the Worker in front of the
// pages and /rpc. Secrets: RPC_URL, set with `wrangler secret put RPC_URL`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vayle-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The site's own domain, a zone on the same Cloudflare account.
  "routes": [{ "pattern": "vayle.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The landing, every app route and /rpc go through the Worker. Everything else is a static
    // file, which Cloudflare serves without running it.
    "run_worker_first": ["/", "/index.html", "/app", "/app/*", "/rpc"],
    "not_found_handling": "404-page",
  },
  "vars": {
    // The only addresses /rpc answers eth_getLogs for: the market, set here after the deploy. The
    // app reads no other contract's logs.
    "RPC_LOG_ADDRESSES": "",
    // Where the app doesn't offer new orders. Settling, stopping and withdrawing stay open
    // everywhere, and so does the fallback page. These are the places Stock Tokens themselves are
    // restricted, as the issuer's terms read on 2026-10-07: the United States and its territories,
    // Canada, the United Kingdom, Switzerland, the United Arab Emirates, and the countries whose
    // investors the issuer prohibits (https://docs.robinhood.com/rhj/restricted-jurisdictions).
    // Plus Tor exits (T1), whose location can't be known.
    "RESTRICTED_COUNTRIES": "US,PR,GU,VI,AS,MP,UM,CA,GB,CH,AE,CU,BY,IR,KP,RU,SY,UA,SS,SD,MM,VE,T1",
    // Regions of a country that's otherwise open, as country-region. None today: the issuer
    // restricts all of Ukraine, so the country entry covers Crimea, Donetsk and Luhansk.
    "RESTRICTED_REGIONS": "",
  },
  // Each visitor's /rpc requests, keyed by address. A poll is a few requests every 15 seconds, and
  // waiting on a transaction adds two or three a second.
  "ratelimits": [
    { "name": "RPC_LIMITER", "namespace_id": "4663", "simple": { "limit": 60, "period": 10 } },
  ],
  "observability": { "enabled": true },
}
