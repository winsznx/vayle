#!/bin/sh
# Runs the repo guard with Node 24 or newer, which executes the TypeScript source directly.
hooks_dir=$(cd "$(dirname "$0")" && pwd)
major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$major" -lt 24 ]; then
  echo "repo-guard: Node 24 or newer is required, found $(node --version 2>/dev/null || echo none)" >&2
  exit 1
fi
exec node "$hooks_dir/../packages/repo-guard/src/cli.ts" "$@"
